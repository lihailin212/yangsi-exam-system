# ============================================================
# 考试系统环境变量示例
#
# 复制成 .env.local（本地）或在部署平台的环境变量里逐条配置。
# .env.local 已被 .gitignore 忽略，密钥绝不能进仓库。
# ============================================================

# ---------- 必填 ----------

# 数据库连接串（Neon Postgres / Supabase / Railway 均可）
# 本地不配则回落到 backend/exam.db（SQLite）
DATABASE_URL=

# JWT 签名密钥。多实例部署必须配成固定值，否则各实例密钥不同、token 互相失效。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 管理员初始密码（仅首次建号时生效，登录后必须改密）
ADMIN_INITIAL_PASSWORD=

# ---------- 微信支付（预留，未配置时在线支付返回 501）----------
# 全部配置齐了才会启用 WeChatNativeProvider
WECHAT_MP_APP_ID=
WECHAT_MP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
# v3 签名用（可选）
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=

# ---------- 短信验证码（预留，未配置时短信登录返回 501）----------
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---------- 前端（构建时注入）----------
# 后端 API 地址；前后端同域部署时留空即可（走 /api 反代）
VITE_API_BASE_URL=
